{
  "name": "contextpin",
  "version": "0.1.0",
  "description": "contextpin is an early-stage local-first developer tool.",
  "type": "module",
  "main": "./src/index.js",
  "bin": {
    "contextpin": "./src/index.js"
  },
  "exports": {
    ".": "./src/index.js"
  },
  "files": [
    "src",
    "docs",
    "fixtures",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "CODE_OF_CONDUCT.md"
  ],
  "scripts": {
    "check": "npm run build",
    "build": "node --check src/index.js",
    "test": "node --test",
    "smoke": "node src/index.js --help && npm run package:smoke",
    "package:smoke": "node scripts/package-smoke.mjs",
    "release:check": "npm run check && npm test && npm run smoke"
  },
  "keywords": [
    "context",
    "pin",
    "cli",
    "developer-tool",
    "productivity"
  ],
  "author": "Roger Chappel",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rogerchappel/contextpin.git"
  },
  "bugs": {
    "url": "https://github.com/rogerchappel/contextpin/issues"
  },
  "homepage": "https://github.com/rogerchappel/contextpin#readme"
}
